
# obviously DO NOT USE IN PRODUCTION OR ANYWHERE OR WHATEVER
# default wallet of localfhenix
# export MNEMONIC="indoor dish desk flag debris potato excuse depart ticket judge file exit"
WALLET=""

# address for tasks 0x4e6206fC78674E5eFf48Dcd0166060f95a832c60 corresponding to the key below
DEPLOYER_PRIVATE_KEY="0xb03608c1c1f1461ed55c1c2315ab27fe82e2fe4c289ff753dea99078848d27dd"

# needed for local networks to deploy createX contract, corresponds to the second account of the mnemonic above
KEY2="0xcb5790da63720727af975f42c79f69918580209889225fa7128c92402a6d3a65"
# intentionally-public LOCAL-ONLY dev key (0x55A07...); the local stack expects this result-processor
# address, so it must stay stable. The wallet is decommissioned everywhere else - never fund or grant
# it anything on a live network.
AGGREGATOR_KEY="dbfae500d71337029492a6f7f6c82e014467d1a847b684a9bca8403fbc0d6e45"
# verifier signer address to be set only on deployment
VERIFIER_ADDRESS="0x0000000000000000000000000000000000000000"
# decrypt result signer address (dispatcher's signing key address)
DECRYPT_RESULT_SIGNER="0x0000000000000000000000000000000000000000"
# Keyed RPC endpoints (e.g. QuickNode). Optional — keyless public RPCs are used when unset.
SEPOLIA_RPC_URL=""
ARBITRUM_SEPOLIA_RPC_URL=""
BASE_SEPOLIA_RPC_URL=""

# ---------------------------------------------------------------------------------------------
# Mainnet deployment (Ethereum, Arbitrum One) — see docs/mainnet-deployment.md for the runbook.
# ---------------------------------------------------------------------------------------------
# Keyed RPC endpoints. Optional — keyless public RPCs are used when unset.
ETHEREUM_RPC_URL=""
ARBITRUM_ONE_RPC_URL=""

# Etherscan API v2 key — one key serves both Ethereum and Arbitrum One (hardhat verify).
ETHERSCAN_API_KEY=""

# The account that signs the mainnet deployment and is the temporary default admin while it
# runs. On a chain where the CoFHEAddressBook has not been handed over yet it must be the book's
# bootstrap owner (deterministic/addresses.json), because it registers the TaskManager there.
# TM_ADMIN_ADDRESS is its address; DEPLOYER_PRIVATE_KEY (above) must be its key.
# To deploy with a different key, re-freeze once before the first deployment on any chain:
#   ADDRESS_BOOK_BOOTSTRAP_OWNER=<its address> FREEZE_FORCE=1 pnpm freeze:addressBook
# TM_ADMIN_DELAY is the default-admin transfer timelock in seconds.
TM_ADMIN_ADDRESS=""
TM_ADMIN_DELAY="600"

# Set to 1 on a live network to let `hardhat deploy` register a brand-new TaskManager when the
# address book reports the id as unset. Off by default: a fresh registration repoints every
# FHE.sol contract on the chain, so it must never happen because an RPC answered wrongly.
REGISTER_TASK_MANAGER=""

# The Gnosis Safe that ends up holding DEFAULT_ADMIN and every operational role.
# SAFE_OWNER_KEY is optional: when set (threshold-1 Safes only), task:acceptAdminAsSafe executes
# the acceptances through the Safe; when unset (multisig, or hardware-held owner keys), the task
# writes a Safe Transaction Builder batch to safe-batches/ to import in the Safe app instead.
# When SAFE_ADMIN_ADDRESS is an EOA (testnets), SAFE_OWNER_KEY is its own key and the acceptances
# are sent directly.
# SAFE_BATCH_OUT optionally overrides where that file is written.
SAFE_ADMIN_ADDRESS=""
SAFE_OWNER_KEY=""
SAFE_BATCH_OUT=""

# Maintenance wallet (e.g. a Ledger) - required on mainnet, optional elsewhere. Granted only
# PAUSER_ROLE and
# SECURITY_ZONE_MANAGER_ROLE on the TaskManager, so it can halt intake (enable/disable) and move
# the security-zone bounds without a multisig round trip. Deliberately NOT granted the admin-equivalent roles
# (UPGRADER, CONFIG_MANAGER, VERIFIER_SIGNER_MANAGER, DECRYPT_SIGNER_MANAGER) - see the role notes
# at the top of TaskManager.sol. Granted by the deploy when set, or later via
# task:grantMaintenanceRoles (which also revokes, with --revoke true).
# Note PAUSER_ROLE can halt all task intake on the chain - treat it as an availability-critical key.
MAINTENANCE_ADDRESS=""
