KEY=0xb03608c1c1f1461ed55c1c2315ab27fe82e2fe4c289ff753dea99078848d27dd

# Keyed RPC endpoint (e.g. QuickNode). Optional — a keyless public RPC is used when unset.
ARBITRUM_SEPOLIA_RPC_URL=""

# ---------------------------------------------------------------------------------------------
# Mainnet deployment (Arbitrum One) — see docs/mainnet-deployment.md for the runbook.
# ---------------------------------------------------------------------------------------------
# Keyed RPC endpoint. Optional — a keyless public RPC is used when unset.
ARBITRUM_ONE_RPC_URL=""

# Etherscan API v2 key (hardhat verify).
ETHERSCAN_API_KEY=""

# The blockchain-poster wallet address that receives posting rights (required off local
# networks), and the default-admin transfer timelock in seconds.
POSTER_ADDRESS=""
REGISTRY_ADMIN_DELAY="600"

# The Gnosis Safe that ends up holding DEFAULT_ADMIN and every operational role.
# SAFE_OWNER_KEY is optional: when set (threshold-1 Safes only), scripts/acceptAdminAsSafe.ts
# executes the acceptance through the Safe; when unset (multisig, or hardware-held owner keys),
# it writes a Safe Transaction Builder batch to safe-batches/ to import in the Safe app instead.
# SAFE_BATCH_OUT optionally overrides where that file is written.
SAFE_ADMIN_ADDRESS=""
SAFE_OWNER_KEY=""
SAFE_BATCH_OUT=""

# The deployed registry proxy — printed by scripts/deploy.ts; needed by the accept/renounce scripts.
COMMITMENT_REGISTRY_ADDRESS=""
